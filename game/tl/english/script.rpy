    # n "　"
    n "…"

# game/script.rpy:585
translate english misc_dialogue_7ea21fa6:

    # n "明日にも、この地域全ての社会システムは崩壊するはずだ。　"
    n "By tomorrow, every social system in this region should have collapsed."

# game/script.rpy:586
translate english misc_dialogue_9c9d6e46:

    # n "俺は決意した。　"
    n "I made up my mind."

# game/script.rpy:587
translate english misc_dialogue_40488444_29:

    # n "　"
    n "…"

# game/script.rpy:588
translate english misc_dialogue_2bccc840:

    # n "はぁはぁ。　"
    n "Hah... hah..."

# game/script.rpy:589
translate english misc_dialogue_51f35c21:

    # n "いくぞ！いいか。　"
    n "Here I go! Ready?"

# game/script.rpy:590
translate english misc_dialogue_75afbf56_3:

    # n "・・・・。　"
    n "...."

# game/script.rpy:591
translate english misc_dialogue_cb7ac548:

    # n "お兄ちゃん、何してるの。入るよ。　"
    n "What are you doing, big brother? I'm coming in."

# game/script.rpy:592
translate english misc_dialogue_a867fc33:

    # n "ちょっと待っ！！！。　"
    n "Wait!!!"

# game/script.rpy:593
translate english misc_dialogue_40488444_30:

    # n "　"
    n "…"

# game/script.rpy:594
translate english misc_dialogue_24053a95:

    # n "お兄ちゃんが嫌いかい？。　"
    n "Do you dislike me, big brother?"

# game/script.rpy:595
translate english misc_dialogue_48f0f8f1_2:

    # n "・・・・　"
    n "...."

# game/script.rpy:596
translate english misc_dialogue_633dbcfc:

    # n "・・。　"
    n ".."

# game/script.rpy:597
translate english misc_dialogue_53f7daa3_3:

    # n "・・・　"
    n "..."

# game/script.rpy:598
translate english misc_dialogue_53f7daa3_4:

    # n "・・・　"
    n "..."

# game/script.rpy:599
translate english misc_dialogue_53f7daa3_5:

    # n "・・・　"
    n "..."

# game/script.rpy:600
translate english misc_dialogue_48f0f8f1_3:

    # n "・・・・　"
    n "...."

# game/script.rpy:601
translate english misc_dialogue_48f0f8f1_4:

    # n "・・・・　"
    n "...."

# game/script.rpy:602
translate english misc_dialogue_40488444_31:

    # n "　"
    n "…"

# game/script.rpy:603
translate english misc_dialogue_40488444_32:

    # n "　"
    n "…"

# game/script.rpy:604
translate english misc_dialogue_a65e4e64_2:

    # n "・・・。　"
    n "..."

# game/script.rpy:605
translate english misc_dialogue_a41bfbb1:

    # n "バッチリと見られてしまった。　"
    n "She saw everything — crystal clear."

# game/script.rpy:606
translate english misc_dialogue_a65e4e64_3:

    # n "・・・。　"
    n "..."

# game/script.rpy:607
translate english misc_dialogue_40488444_33:

    # n "　"
    n "…"

# game/script.rpy:608
translate english misc_dialogue_3da145d9:

    # n "誘拐に関する書籍や、犯罪の記事をネットで調べた。　"
    n "I researched kidnapping books and crime articles online."

# game/script.rpy:609
translate english misc_dialogue_7290b817:

    # n "誘拐犯として捕まっているバカな変態犯人は、みな衝動的に行動しているか、精神的にどうかしている奴らが多い。　"
    n "The idiot perverts who get caught for kidnapping mostly acted on impulse — or were mentally unsound to begin with."

# game/script.rpy:610
translate english misc_dialogue_baff2658:

    # n "捕まらないための思慮が欠落していて、「捕まえて下さい」と言ってるような軽はずみな行動を取っている。　"
    n "She shows no caution about getting caught — her careless behavior practically begs, 'please catch me.'"

# game/script.rpy:611
translate english misc_dialogue_2fd9dc0d:

    # n "けして念密に計画し、慎重に行動しているわけではないのだ。　"
    n "It's not as if I planned this meticulously and acted with great care."

# game/script.rpy:612
translate english misc_dialogue_bd2d8556:

    # n "俺は、そんな馬鹿な誘拐犯にはならない。　"
    n "I refuse to become such a stupid kidnapper."

# game/script.rpy:613
translate english misc_dialogue_30ade255:

    # n "誘拐の瞬間しか、りこちゃんと接点が無いのだから、その瞬間だけ注意すればいい。　"
    n "The moment of abduction is my only contact with Riko — so I only need to be careful for that one instant."

# game/script.rpy:614
translate english misc_dialogue_a9fc760f:

    # n "どこか人気のない田舎でひっそり暮せば、絶対にバレない。　"
    n "If we lived quietly in some deserted countryside, no one would ever find out."

# game/script.rpy:615
translate english misc_dialogue_2c64e190:

    # n "誘拐場所は？　"
    n "And the abduction spot?"

# game/script.rpy:616
translate english misc_dialogue_88488253:

    # n "人目に付かない場所となると‥一人で出かける時か、登下校時しかない。"
    n "For somewhere out of sight... it'd have to be when she goes out alone — to or from school."

# game/script.rpy:617
translate english misc_dialogue_fe0e2b50:

    # n "もう日にちが無いから外出時は無理だ。登校時も人目が多い。　"
    n "There aren't many days left, so outdoors is out. And too many eyes on the way to school."

# game/script.rpy:618
translate english misc_dialogue_d1830a4b:

    # n "下校通学路で、一人になった時に車に連れ込み拘束し、急いでその場から立ち去る方がいい。　"
    n "Better to grab her on the school road when she's alone — pull her into a car, restrain her, and leave the area fast."

# game/script.rpy:619
translate english misc_dialogue_9411c829:

    # n "通学路なら‥４丁目の３つかど辺りがいい。人目につきにくい場所だ。　"
    n "The school road... the three-way corner in block 4 would be good. Few eyes pass that way."

# game/script.rpy:620
translate english misc_dialogue_ba8bb90b:

    # n "災害がそこまで迫ってる。チャンスは明後日の帰宅時くらいしかない！　"
    n "The disaster is nearly here. My only chance is their return home the day after tomorrow!"

# game/script.rpy:621
translate english misc_dialogue_a1c2db98:

    # n "本当に、俺にやれるだろうか？　"
    n "Can I really go through with it?"

# game/script.rpy:622
translate english misc_dialogue_7ef12134:

    # n "誘拐する瞬間を誰かに見られたら‥失敗は許されない‥。　"
    n "If someone saw the moment I took her... failure would be unforgivable..."

# game/script.rpy:623
translate english misc_dialogue_3c20d6db:

    # n "誘拐に必要な手錠、催涙スプレー、丈夫なロープなどを準備しないと。　"
    n "I'll need to prepare the essentials: handcuffs, pepper spray, sturdy rope."

# game/script.rpy:624
translate english misc_dialogue_40488444_34:

    # n "　"
    n "…"

# game/script.rpy:625
translate english misc_dialogue_301b60d0:

    # n "言い過ぎたかな。　"
    n "Did I go too far just now?"

# game/script.rpy:626
translate english misc_dialogue_a65e4e64_4:

    # n "・・・。　"
    n "..."

# game/script.rpy:627
translate english misc_dialogue_b55bb09c:

    # n "仕方ない。あいつに謝りに行くか・・・・　"
    n "Can't be helped. I suppose I'll go apologize to her...."

# game/script.rpy:628
translate english misc_dialogue_40488444_35:

    # n "　"
    n "…"

# game/script.rpy:629
translate english misc_dialogue_5bef14bf:

    # n "はぁはぁ・・よし、先回りできたはずだ。　"
    n "Hah, hah... good — I should have gotten ahead of her."

# game/script.rpy:630
translate english misc_dialogue_79aef904:

    # n "時間はっと。　"
    n "Would you look at the time."

# game/script.rpy:631
translate english misc_dialogue_d3929052:

    # n "３時４５分。もう直りこちゃんはあの道から現れるはずだ。　"
    n "3:45. Riko should appear on that road any minute now."

# game/script.rpy:632
translate english misc_dialogue_74aafcdd:

    # n "拘束する布テープも準備OKだ。　"
    n "The cloth tape for restraint — ready to go."

# game/script.rpy:633
translate english misc_dialogue_40488444_36:

    # n "　"
    n "…"

# game/script.rpy:634
translate english misc_dialogue_8e378eca_1:

    # n "緊張する。　"
    n "I'm nervous."

# game/script.rpy:635
translate english misc_dialogue_dca8fd27:

    # n "周りに誰も居ないか確認しないと。　"
    n "I'd better make sure no one's around."

# game/script.rpy:636
translate english misc_dialogue_63965fa7:

    # n "あ。　"
    n "Ah."

# game/script.rpy:637
translate english misc_dialogue_731441f8:

    # n "来た！　"
    n "Here she comes!"

# game/script.rpy:638
translate english misc_dialogue_40488444_37:

    # n "　"
    n "…"

# game/script.rpy:639
translate english misc_dialogue_48798e34:

    # n "手が出せなかった　"
    n "I couldn't bring myself to touch her."

# game/script.rpy:640
translate english misc_dialogue_ef6f3e21:

    # n "失敗だ　"
    n "It's a failure."

# game/script.rpy:641
translate english misc_dialogue_e652d5e6:

    # n "今日を逃せば、もう日はないというのに。　"
    n "Miss today, and there may be no other chance."

# game/script.rpy:642
translate english misc_dialogue_cb930bc5:

    # n "玄関の扉を開くりこちゃんの横顔を見ながら、俺は路上にひざをついた。　"
    n "As the front door opened, I sank to my knees on the road, watching Riko's profile."

# game/script.rpy:643
translate english misc_dialogue_40488444_38:

    # n "　"
    n "…"

# game/script.rpy:644
translate english misc_dialogue_48798e34_1:

    # n "手が出せなかった　"
    n "I couldn't bring myself to touch her."

# game/script.rpy:645
translate english misc_dialogue_ef6f3e21_1:

    # n "失敗だ　"
    n "It's a failure."

# game/script.rpy:646
translate english misc_dialogue_e652d5e6_1:

    # n "今日を逃せば、もう日はないというのに。　"
    n "Miss today, and there may be no other chance."

# game/script.rpy:647
translate english misc_dialogue_b3df6ee5:

    # n "そうだ！りこちゃんの自宅の近所のあの道なら、人目は少ないかも！　"
    n "That's it! That street near Riko's house — hardly anyone's around there!"

# game/script.rpy:648
translate english misc_dialogue_aee4461d:

    # n "迷ってる時間はない。急ごう！　"
    n "No time to hesitate. Hurry!"

# game/script.rpy:649
translate english misc_dialogue_40488444_39:

    # n "　"
    n "…"

# game/script.rpy:650
translate english misc_dialogue_26ca01cb:

    # n "災害後に○学校へ侵入する。　"
    n "After the disaster, I slip into the ○ school."

# game/script.rpy:651
translate english misc_dialogue_dc409ed0:

    # n "学校や社会機能が麻痺している隙に、りこちゃんをいただく。"
    n "While school and society lay paralyzed — I shall help myself to Riko."

# game/script.rpy:652
translate english misc_dialogue_a8f0984a:

    # n "普段なら不可能な事も、災害後ならできるだろう。　"
    n "What would be impossible in normal times should be possible after a disaster."

# game/script.rpy:653
translate english misc_dialogue_929854f1:

    # n "支援（ボランティア）に来たとでも言えばいい。　"
    n "I'll just say I came to volunteer."

# game/script.rpy:654
translate english misc_dialogue_ed36696c:

    # n "俺は食料など準備して、その時が来るまで安全な場所で待つ事にした。　"
    n "I stocked up on food and resolved to wait in a safe place until the time came."

# game/script.rpy:655
translate english misc_dialogue_40488444_40:

    # n "　"
    n "…"

# game/script.rpy:656
translate english misc_dialogue_2118eaac:

    # n "災害は起こった。　"
    n "The disaster struck."

# game/script.rpy:657
translate english misc_dialogue_d5f2de42:

    # n "しかし叔父のいうような大規模なものでなかった。　"
    n "But it wasn't the large-scale disaster my uncle had described."

# game/script.rpy:658
translate english misc_dialogue_98124230:

    # n "それでも街はいたる所で寸断され、社会機能はストップしている。　"
    n "Even so, the town was cut off everywhere, and society had ground to a halt."

# game/script.rpy:659
translate english misc_dialogue_40488444_41:

    # n "　"
    n "…"

# game/script.rpy:660
translate english misc_dialogue_e45d412a:

    # n "青山○学校へ行ってみると校舎は無事であり、強引な進入は難しそうだった。　"
    n "I went to Aoyama ○ School — the building was intact, and forcing my way in looked difficult."

# game/script.rpy:661
translate english misc_dialogue_0a42c3af:

    # n "とは言え、校舎から聞こえてくる声から混乱している様子がうかがえる。　"
    n "Even so, the voices drifting from the schoolhouse suggest panic and confusion."

# game/script.rpy:662
translate english misc_dialogue_02e63989:

    # n "学校として機能はしてないようで、忙しそうに廊下を行き来する教員が見える。　"
    n "The school barely functions, yet teachers can be seen hurrying up and down the halls."

# game/script.rpy:663
translate english misc_dialogue_e8024ea5:

    # n "俺は早速校舎へ向かった。　"
    n "I set off at once for the school building."

# game/script.rpy:664
translate english misc_dialogue_40488444_42:

    # n "　"
    n "…"

# game/script.rpy:665
translate english misc_dialogue_d861c9fe:

    # staff "ボランティアを引き受けてくれるというのは君ですか？"
    staff "Are you the one who's agreed to volunteer?"

# game/script.rpy:666
translate english misc_dialogue_08ae2c7a:

    # riko "はい。お手伝します"
    riko "Yes. I'll help."

# game/script.rpy:667
translate english misc_dialogue_a91cadcd:

    # staff "大変ありがたい。職員や子供達の保護者にも連絡がつかなくて人手が全く足りてないんでね"
    staff "We're deeply grateful. We can't reach the staff or the children's guardians — we're completely short-handed."

# game/script.rpy:668
translate english misc_dialogue_1f5089c7:

    # staff "早速ですけど、今からお願いできたら助かるんだけど、どうですか？"
    staff "I know it's sudden, but it would be a great help if you could start right away. What do you say?"

# game/script.rpy:669
translate english misc_dialogue_9cb9f4d4:

    # riko "分かりました。何をすればいいですか？"
    riko "Understood. What should I do?"

# game/script.rpy:670
translate english misc_dialogue_7c6b51ff:

    # staff "個人事情などで学校に出てこれる職員がわずか２人なんです"
    staff "Due to personal circumstances, only two of our staff were able to come in."

# game/script.rpy:671
translate english misc_dialogue_10b418ac:

    # staff "私達職員は大変忙しくて、学校に残ってる子供達を見ている暇がないんです"
    staff "We staff are far too busy — we have no time to watch over the children still at the school."

# game/script.rpy:672
translate english misc_dialogue_eb9d799f:

    # staff "子供達は混乱しているので臨時先生になって、見てやって下さい"
    staff "The children are confused — please become their substitute teacher and look after them."

# game/script.rpy:673
translate english misc_dialogue_df29b4c1:

    # riko "こんな状況で帰宅してない子が居るんですか？"
    riko "You're saying some children still haven't made it home in this situation?"

# game/script.rpy:674
translate english misc_dialogue_0d1faa6f:

    # staff "ええ数名。両親と連絡が取れなくて帰宅させたくても出来ないんです"
    staff "Yes, several. We can't reach their parents, so we can't send them home even if we wanted to."

# game/script.rpy:675
translate english misc_dialogue_f7ca9de3:

    # staff "では、教室に案内します。子供達の気がまぎれるなら、授業でも何でも構いませんよ"
    staff "Then allow me to show you to the classroom. If it takes the children's minds off things, lessons or anything at all is fine."

# game/script.rpy:676
translate english misc_dialogue_40488444_43:

    # n "　"
    n "…"

# game/script.rpy:677
translate english misc_dialogue_5c501643:

    # n "先生と俺が教室へ入ると、とたんに子供達のおしゃべりが消えた。　"
    n "The moment the teacher and I entered the classroom, the children's chatter died away."

# game/script.rpy:678
translate english misc_dialogue_1f869aa0:

    # student "きりーつ。れい。ちゃくせき"
    student "'Rise. Bow. Sit.'"

# game/script.rpy:679
translate english misc_dialogue_9f242638:

    # staff "今日から臨時でみんなを見てくれる○○先生です。先生の言う事をちゃんと聞くように"
    staff "This is Mr. ○○, who will be looking after everyone as of today, temporarily. You will all listen to what your teacher says."

# game/script.rpy:680
translate english misc_dialogue_b54cafb4:

    # riko "○○です。みなさんが安全にお家に帰れるまで、どうぞよろしく"
    riko "This is ○○. Please look after everyone until they can get home safely."

# game/script.rpy:681
translate english misc_dialogue_16d3957f:

    # n "俺の簡単な挨拶後、汚れた白衣の教員は”後はよろしく”と言い残し教室から出て行った。　"
    n "After my brief greeting, the teacher in the filthy lab coat left the classroom with the words, \"The rest is up to you.\""

# game/script.rpy:682
translate english misc_dialogue_e28c128c:

    # n "少し動揺してる俺。こうも早急に児童に指導できる立場になれるとは思ってもなかった。　"
    n "I was a little shaken. I never dreamed I'd find myself in a position to instruct children so soon."

# game/script.rpy:683
translate english misc_dialogue_6b09c042:

    # n "みんなじっと俺を見て支持を待っている。　"
    n "Everyone stares at me, waiting for my instructions."

# game/script.rpy:684
translate english misc_dialogue_be24c6d1:

    # n "「心細いだろうけど、そのうち家族の人が迎えにきれくれるから、それまで・・」　"
    n "I know you're scared, but your family will come for you soon, so until then..."

# game/script.rpy:685
translate english misc_dialogue_553f66a1:

    # n "適当な会話で時間をつぶしながら、俺の視線はりこちゃんを探す。　"
    n "Making idle small talk to pass the time, my eyes search for Riko."

# game/script.rpy:686
translate english misc_dialogue_988364da:

    # n "いた！　"
    n "Found her!"

# game/script.rpy:687
translate english misc_dialogue_ab1c81dd:

    # n "それから１時間目、２時間目と手作り授業を進めた。　"
    n "From there, I carried on with my hand-made lessons through first and second period."

# game/script.rpy:688
translate english misc_dialogue_da42b840:

    # n "朝からずっと、りこちゃんに手を出せる立場、距離にいるので、俺の股間の勃起が止まない。　"
    n "All morning I've been in a position, at a distance, where I could reach out and take Riko — and my hard-on just won't go down."

# game/script.rpy:689
translate english misc_dialogue_c3cbf4d0:

    # n "このままでは、いずれ児童に大きく膨らんだ股間を発見され、初日からロリコン先生のレッテル貼られ解雇だ。　"
    n "At this rate, a child will spot my swollen bulge, and I'll be fired on day one with a pedo-teacher label."

# game/script.rpy:690
translate english misc_dialogue_a9dfc3ce:

    # n "朝から一向に”あの教員”は俺の授業を見に来ない。　"
    n "All morning, 'that teacher' hasn't come to observe my class once."

# game/script.rpy:691
translate english misc_dialogue_4325c474:

    # n "それにここに残る子は親元に帰れる事ができない。つまり親に学校であった出来事を話せない。　"
    n "Besides, the children who stay here can't go home to their parents. Which means they can't tell them what happens at school."

# game/script.rpy:692
translate english misc_dialogue_659a9531:

    # n "・・危険な賭けだが、やってみるか。　"
    n "...It's a dangerous gamble, but let's give it a try."

# game/script.rpy:693
translate english misc_dialogue_5a956249:

    # riko "ちょっとみんな聞いて。実はこの災害で心の病気になる人が出ている"
    riko "Everyone, listen. The truth is, this disaster has been causing mental illness in some people."

# game/script.rpy:694
translate english misc_dialogue_de4d8c25:

    # riko "そこで、この時間はみんなの心のケアをする事にした"
    riko "So for this period, we're going to look after everyone's hearts."

# game/script.rpy:695
translate english misc_dialogue_e5617353:

    # n "家から持ってきたリュックから、準備しておいた目隠しを取り出した。　"
    n "From the backpack I'd brought from home, I took out the blindfold I'd prepared."

# game/script.rpy:696
translate english misc_dialogue_e160bf48:

    # riko "この目隠しをして、手は椅子の後ろで組んで"
    riko "Put this blindfold on, and put your hands behind the chair."

# game/script.rpy:697
translate english misc_dialogue_3a450eec:

    # n "強引な指示に多少動揺はあったが、さすが先生の言葉。皆素直に目隠しを結びだした。　"
    n "My abrupt orders caused some unease — but these were a teacher's words. One by one, they obediently tied on their blindfolds."

# game/script.rpy:698
translate english misc_dialogue_314771ff:

    # riko "先生が見てるから、ゆっくり深く深呼吸を続けて"
    riko "I'm watching, so keep breathing slowly and deeply."

# game/script.rpy:699
translate english misc_dialogue_458c8a65:

    # riko "動いたら検査にならないから、絶対に動かないように"
    riko "If you move, the examination won't count — so whatever you do, don't move."

# game/script.rpy:700
translate english misc_dialogue_731d919c:

    # riko "先生が見てて病気かもしれない子には、少し触れるけど、動かないように我慢してな"
    riko "As your teacher, I'll have to touch you a little to check for the illness. Be a good girl and hold still."

# game/script.rpy:701
translate english misc_dialogue_1cf5736b:

    # n "全員がしっかり目隠しするの待ち・・教室のドアをゆっくり開いた。　"
    n "I waited until every child was blindfolded... then slowly opened the classroom door."

# game/script.rpy:702
translate english misc_dialogue_a0325e56:

    # n "廊下を見わたし、あの教員が居ない事を確認してから、こっそりとりこちゃんの席へ移動した。　"
    n "Glancing down the hallway to confirm that teacher was gone, I slipped over to Riko's seat."

# game/script.rpy:703
translate english misc_dialogue_d524ea0f:

    # n "あの先生が来ない今なら、ちょっとくらい・・。"
    n "With that teacher gone, maybe just a little..."

# game/script.rpy:704
translate english misc_dialogue_9ac29437:

    # n "教室の子供達は全員大人しくしている。　"
    n "All the children in the classroom sit quietly."

# game/script.rpy:705
translate english misc_dialogue_5816ef97:

    # n "ゆっくりやらないと、りこちゃんが怯えるし、他の子にも聞こえてしまう。　"
    n "I have to go slowly — Riko will panic, and the other children might hear."

# game/script.rpy:706
translate english misc_dialogue_40488444_44:

    # n "　"
    n "…"

# game/script.rpy:707
translate english misc_dialogue_40488444_45:

    # n "　"
    n "…"

# game/script.rpy:708
translate english misc_dialogue_8fa4f492:

    # n "やはりセーラー服似合うな。　"
    n "The sailor uniform really does suit her."

# game/script.rpy:709
translate english misc_dialogue_4daceb71:

    # n "さて、いいもの見せてやるよ。こいつをな！　"
    n "Now, I'll show you something good. Behold!"

# game/script.rpy:710
translate english misc_dialogue_40488444_46:

    # n "　"
    n "…"

# game/script.rpy:711
translate english misc_dialogue_2486d2b5:

    # n "両手でやさしくさわって　"
    n "Touch it gently, with both hands."

# game/script.rpy:712
translate english misc_dialogue_1b0a5092:

    # n "手をそえるんだ　"
    n "Rest your hand on it."

# game/script.rpy:713
translate english misc_dialogue_40488444_47:

    # n "　"
    n "…"

# game/script.rpy:714
translate english misc_dialogue_1b1aee7d:

    # n "いい感触だろ？　"
    n "Feels good, doesn't it?"

# game/script.rpy:715
translate english misc_dialogue_d7748606:

    # n "じゃ、キャンデーを舐めるように、口に入れるんだ。"
    n "Now — put it in your mouth, like you'd suck on a piece of candy."

# game/script.rpy:716
translate english misc_dialogue_58076c43:

    # n "家に帰りたいなら、心をこめて上手にしゃぶるんだ。　"
    n "If you want to go home, put your heart into it and suck it properly."

# game/script.rpy:717
translate english misc_dialogue_5cf1e611:

    # n "下手なら、一生ここで暮すしかないな。　"
    n "And if you do badly — well, you'll just have to live here for the rest of your life."

# game/script.rpy:718
translate english misc_dialogue_40488444_48:

    # n "　"
    n "…"

# game/script.rpy:719
translate english misc_dialogue_1433538f:

    # n "やりすぎたか。　"
    n "Did I go too far?"

# game/script.rpy:720
translate english misc_dialogue_aa190341:

    # n "用心しないと、他の先生にバレたら人生終了だ。　"
    n "I'd better be careful — if another teacher finds out, my life is over."

# game/script.rpy:721
translate english misc_dialogue_d845ae2c:

    # n "でもここに残ってるって事は保護者とも連絡がついていないばずだ。　"
    n "But the fact that they're still here means their guardians can't be reached either."

# game/script.rpy:722
translate english misc_dialogue_ee21b935:

    # n "なら、もっと強引に行ってもいいかも。　"
    n "In that case — maybe I can afford to be a little more forceful."

# game/script.rpy:723
translate english misc_dialogue_40488444_49:

    # n "　"
    n "…"

# game/script.rpy:724
translate english misc_dialogue_138d6634:

    # n "■翌日■　"
    n "The next day"

# game/script.rpy:725
translate english misc_dialogue_f2f4aae7:

    # staff "あ、君。野田先生を見なかったかい？"
    staff "Teacher: Ah, you there. Have you seen Mr. Noda?"

# game/script.rpy:726
translate english misc_dialogue_0140a805:

    # riko "いいえ、何かあったのですか？"
    riko "No. Did something happen?"

# game/script.rpy:727
translate english misc_dialogue_24be9f91:

    # staff "実は、こんなメモを残して無断で消えてしまったんだ"
    staff "Teacher: The thing is, he left this note and vanished without a word."

# game/script.rpy:728
translate english misc_dialogue_bd2652bc:

    # n "メモには”家族が心配なので一時○県の実家へ行く。身勝手な行動申し訳ない”とあった。　"
    n "The note read: \"Worried for our family, we have gone to our parents' home in ○ prefecture for a while. Forgive our selfishness.\""

# game/script.rpy:729
translate english misc_dialogue_5830b5ec:

    # staff "昨日は、また災害があるかも。と怯えていたからね"
    staff "Teacher: He was terrified yesterday, saying another disaster might come."

# game/script.rpy:730
translate english misc_dialogue_42c65f5b:

    # staff "正直私だって怖いよ"
    staff "Teacher: Honestly, I'm scared too."

# game/script.rpy:731
translate english misc_dialogue_40488444_50:

    # n "　"
    n "…"

# game/script.rpy:732
translate english misc_dialogue_5a337671:

    # n "午後になって、さっきの先生の姿も見えなくなった。　"
    n "By afternoon, the teacher from before was nowhere to be seen."

# game/script.rpy:733
translate english misc_dialogue_0a53e383:

    # n "大げさに声出して呼びながら校舎内全て探したが見当たらない。　"
    n "I called out loudly as I searched the whole school building — she was nowhere to be found."

# game/script.rpy:734
translate english misc_dialogue_9ffd76e3:

    # n "どうやらラジオで、さらに大きな災害があると報道しているようだ。　"
    n "The radio seems to be reporting that an even bigger disaster is coming."

# game/script.rpy:735
translate english misc_dialogue_1be235dd:

    # n "願ってもない絶好のチャンスだ。残ってる子供らだけ。なんとでも誤魔化せる。　"
    n "A golden opportunity beyond my wildest hopes. Only the children remain. I can explain away anything."

# game/script.rpy:736
translate english misc_dialogue_53cfebd1:

    # n "今ならヤレる！りこちゃんはどこに居だ。　"
    n "I can do it now! Where is Riko?"

# game/script.rpy:737
translate english misc_dialogue_79b4e024:

    # n "股間は激しく脈打ち、獲物を探す足取りはどんどん速くなる。　"
    n "My groin throbs fiercely, and my steps quicken as I hunt for prey."

# game/script.rpy:738
translate english misc_dialogue_40488444_51:

    # n "　"
    n "…"

# game/script.rpy:739
translate english misc_dialogue_2e9c22d3:

    # n "■数日後■　"
    n "Several days later"

# game/script.rpy:740
translate english misc_dialogue_e9b33334:

    # n "あのなんとか言う先生は、今日になっても戻ってこない。　"
    n "That teacher — whatever his name was — still hasn't come back today."

# game/script.rpy:741
translate english misc_dialogue_f2bc5669:

    # n "俺は占領状態の青山○学校で、りこちゃんを犯し続けた。　"
    n "In the occupied Aoyama ○ School, I took Riko again and again."

# game/script.rpy:742
translate english misc_dialogue_07e50996:

    # n "後の事など何も考えず、ただ欲望のまま突き進んだ。　"
    n "Without a thought for the consequences, I plunged ahead on desire alone."

# game/script.rpy:743
translate english misc_dialogue_5cdeb77d:

    # n "この○学校は、まるで社会から存在を忘れさられてしまったかのようだ。　"
    n "This school seems to have been utterly forgotten by society."

# game/script.rpy:744
translate english misc_dialogue_ce912870:

    # n "非難したのだろうか？ここ最近近所で人の気配がしない。これは俺に好都合だ。"
    n "Have they all fled? No sign of anyone in the neighborhood lately. This suits me perfectly."

# game/script.rpy:745
translate english misc_dialogue_088510ac:

    # n "教室の子供達も俺の行為を不振がってはいたが、そこままだ○学生。　"
    n "The children in class were suspicious of my conduct too — but they were only ○ schoolers."

# game/script.rpy:746
translate english misc_dialogue_8863ba75:

    # n "学校という閉鎖空間と先生という特権を活かし、俺が罰則を作り全員の行動を支配できた。"
    n "Using the closed world of the school and the privilege of being a teacher, I made the rules and controlled everyone's actions."

# game/script.rpy:747
translate english misc_dialogue_99144145:

    # n "他に大人が居ないので、児童は俺の言いなりなる他なかった。"
    n "With no other adults around, the children had no choice but to obey me."

# game/script.rpy:748
translate english misc_dialogue_70760d24:

    # n "そんな状況の中、俺の行動はさらに大胆になっていた。"
    n "Amid all that, my actions grew even bolder."

# game/script.rpy:749
translate english misc_dialogue_40488444_52:

    # n "　"
    n "…"

# game/script.rpy:750
translate english misc_dialogue_08fbd9e8:

    # n "「～校内放送、望月りこさん、先生のところへ来なさい～」　"
    n "~School announcement: Mochizuki Riko, please come to the teacher's office~"

# game/script.rpy:751
translate english misc_dialogue_40488444_53:

    # n "　"
    n "…"

# game/script.rpy:752
translate english misc_dialogue_f0a434e6:

    # n "恥ずかしがる、りこちゃんを男子トイレに無理やり引き入れた。　"
    n "I dragged the bashful Riko into the boys' restroom by force."

# game/script.rpy:753
translate english misc_dialogue_7c42b190:

    # n "ここ３Fは使ってないから、誰もこないだろう。　"
    n "Nobody uses this third floor, so no one will come."

# game/script.rpy:754
translate english misc_dialogue_02acb504:

    # n "「この前、教室で心の病気の検査したよね。残念だけどりこちゃん病気にかかってるんだ」　"
    n "Remember the mental health check we did in class the other day? I'm sorry, Riko, but you've come down with an illness."

# game/script.rpy:755
translate english misc_dialogue_c434c87c:

    # riko "直に病院に行かないといけないけど、災害で病院も機能してないんだ"
    riko "You need to go to a hospital right away, but with the disaster, they aren't functioning."

# game/script.rpy:756
translate english misc_dialogue_503a7d40:

    # n "「でも心配ないよ。先生は治療方法を知ってるから、治療してあげられる」　"
    n "But don't worry. I know the cure, so I can treat you."

# game/script.rpy:757
translate english misc_dialogue_bdb96b3f:

    # riko "どこか痛くなる病気ですか？"
    riko "Is it an illness that hurts somewhere?"

# game/script.rpy:758
translate english misc_dialogue_35342523:

    # n "「治療しなければ大変な事になるよ。死ぬ人も居るらしい」　"
    n "If it isn't treated, things will get very serious. Some people have even died."

# game/script.rpy:759
translate english misc_dialogue_aa365e00:

    # n "「変わった病気だから、りこちゃんの為にも秘密にしてあげる。この中で治療しよう。さぁ入って」　"
    n "It's a rare illness, so for your sake I'll keep it secret. We'll treat it in here. Come in."

# game/script.rpy:760
translate english misc_dialogue_68153a40:

    # riko "え、これ治療ですか？"
    riko "Huh? Is this some kind of treatment?"

# game/script.rpy:761
translate english misc_dialogue_54c3c7bb:

    # n "「そうだよ。りこちゃんの身体の為なんだ。急いで治療しないとね」　"
    n "That's right. It's for your body's sake, Riko. We must treat you right away."

# game/script.rpy:762
translate english misc_dialogue_a06e470a:

    # riko "で、でも。これって・・・"
    riko "B-but. This is..."

# game/script.rpy:763
translate english misc_dialogue_bba2ee38:

    # riko "すぐすむよ。怖くないから。"
    riko "It'll be over soon. There's nothing to be scared of."

# game/script.rpy:764
translate english misc_dialogue_76e5ea6d:

    # riko "先生、これ治療じゃないです"
    riko "Sir, this isn't treatment."

# game/script.rpy:765
translate english misc_dialogue_bf46957e:

    # riko "いいから、早くここに入りなさい！"
    riko "Never mind that — get in here, quick!"

# game/script.rpy:766
translate english misc_dialogue_7c71e1e6:

    # riko "先生、手をはなして下さい"
    riko "Sir, please let go of me."

# game/script.rpy:767
translate english misc_dialogue_73565a8e:

    # n "「このままでは死んでしまうかしれないんだよ」　"
    n "You might not survive at this rate, you know."

# game/script.rpy:768
translate english misc_dialogue_de1d3fff:

    # n "「それに、先生の言う事が聞けないのか！」　"
    n "Are you saying you won't listen to your teacher, too?!"

# game/script.rpy:769
translate english misc_dialogue_4c1af81e:

    # riko "え、はい。分かりました"
    riko "Oh. Yes. Understood."

# game/script.rpy:770
translate english misc_dialogue_d6a3db8d:

    # n "「大人しくしてなよ。男子に気づかれるぞ」　"
    n "Keep still. The boys will notice."

# game/script.rpy:771
translate english misc_dialogue_30bdbf7f:

    # riko "はい"
    riko "Yes."

# game/script.rpy:772
translate english misc_dialogue_40488444_54:

    # n "　"
    n "…"

# game/script.rpy:773
translate english misc_dialogue_c8fb4119:

    # n "りこちゃんは誰ともあまりしゃべらなくなった。"
    n "Riko gradually stopped speaking to anyone."

# game/script.rpy:774
translate english misc_dialogue_e01803c2:

    # n "教室でも一人で居る時が多くなっていた。　"
    n "Even in the classroom, she spent more and more time alone."

# game/script.rpy:775
translate english misc_dialogue_9fd8a201:

    # n "俺が近づくと、りこちゃんは意識して俺から遠ざかろうした。　"
    n "Whenever I approached, Riko consciously tried to put distance between us."

# game/script.rpy:776
translate english misc_dialogue_2526e26b:

    # n "そういった危険な関係が俺の股間をよけいに興奮させた。"
    n "That dangerous kind of relationship only made my groin burn hotter."

# game/script.rpy:777
translate english misc_dialogue_6b5f607a:

    # n "ある時は体育倉庫で、ある時は屋上で"
    n "Sometimes in the gym storage room, sometimes on the rooftop..."

# game/script.rpy:778
translate english misc_dialogue_fb403341:

    # n "りこちゃんを呼びつけては、他の子供達に隠れて犯し続けた。　"
    n "I would summon Riko and take her again and again, hidden from the other children."

# game/script.rpy:779
translate english misc_dialogue_b3dc54c0:

    # n "いつしか俺は自由にりこちゃんという美少女を犯せる快感に我を忘れていた。"
    n "Before I knew it, I had lost myself in the thrill of being free to ravage the beautiful girl called Riko whenever I pleased."

# game/script.rpy:780
translate english misc_dialogue_3db1de2a:

    # n "そんな危険な陵辱の日々は、それから数日続いた。"
    n "Those perilous days of violation continued for several days after that."

# game/script.rpy:781
translate english misc_dialogue_40488444_55:

    # n "　"
    n "…"

# game/script.rpy:782
translate english misc_dialogue_f50e832c:

    # n "■６日後■　"
    n "Six days later"

# game/script.rpy:783
translate english misc_dialogue_913516df:

    # n "消えた先生が仲間を連れて戻ってきた。　"
    n "The teacher who vanished returned — with others in tow."

# game/script.rpy:784
translate english misc_dialogue_b631fe93:

    # n "大きな白いマスクをつけて　"
    n "Wearing a big white mask."

# game/script.rpy:785
translate english misc_dialogue_db821e51:

    # n "先生達は学校の悲惨な状況に驚いていたが、何も俺に言わなかった。　"
    n "The teachers were shocked at the school's wretched condition, but said nothing to me."

# game/script.rpy:786
translate english misc_dialogue_0a63a036:

    # n "子供達や学校を見捨て、自分だけ助かろうと逃げ出したした事が後ろめたいのだろう。　"
    n "Ashamed, no doubt, of abandoning the children and the school to save their own skins."

# game/script.rpy:787
translate english misc_dialogue_31e23ac2:

    # n "だが子供達は違った。一部が俺の目を盗み、先生達の戻った職員室へ向かった。　"
    n "But the children were different. Some slipped past my watch and headed for the staff room the teachers had returned to."

# game/script.rpy:788
translate english misc_dialogue_7010bacc:

    # n "俺は目を閉じて、校庭でその時が来るのを待った。　"
    n "I closed my eyes and waited in the schoolyard for the moment to come."

# game/script.rpy:789
translate english misc_dialogue_e5353c66:

    # n "どれくらい時間がたっただろう。　"
    n "How much time has passed, I wonder."

# game/script.rpy:790
translate english misc_dialogue_4e04689c:

    # n "音がして目を開くと、りこちゃんが立っていて俺を見て泣いていた。　"
    n "A sound woke me — Riko was standing there, looking at me, crying."

# game/script.rpy:791
translate english misc_dialogue_b2d8ee50:

    # n "走り去った彼女の後ろから、神妙な顔をした先生が近づいてくる。　"
    n "From behind her as she ran off, a teacher with a grave expression came toward me."

# game/script.rpy:792
translate english misc_dialogue_94e7d07d:

    # teacher "実は、この地域は大変危険な化学物質で汚染されていてね"
    teacher "The truth is, this region has been contaminated by a very dangerous chemical."

# game/script.rpy:793
translate english misc_dialogue_883c8741:

    # teacher "子供達には害は無いんだが、その話にくいんだが・・大人には致命傷なんだよ"
    teacher "It's harmless to the children, though it's hard to talk about... but to adults, it's fatal."

# game/script.rpy:794
translate english misc_dialogue_79f75de3:

    # teacher "ラジオくらいは聞いているだろうと・・・君に伝える手段が無かった・・"
    teacher "I assumed you'd at least hear the radio... I had no way to reach you..."

# game/script.rpy:795
translate english misc_dialogue_05f73ecf:

    # n "なぜだろう・・先生の声が遠くに聞こえる・・　"
    n "Strange... the teacher's voice sounds so far away..."

# game/script.rpy:796
translate english misc_dialogue_cd3c213e:

    # teacher "治療は・・遅すぎた・・。死・・・心から・・・"
    teacher "The treatment... came too late... My death... I'm sorry, from my heart..."

# game/script.rpy:797
translate english misc_dialogue_801a5b2b:

    # n "・・全身の力が・・抜けてい・・く・・だめだ・・　"
    n "...My whole body... is losing... strength... I can't... go on..."

# game/script.rpy:798
translate english misc_dialogue_40488444_56:

    # n "　"
    n "…"

# game/script.rpy:799
translate english misc_dialogue_3cf79b63:

    # n "やったぞ！信じられない　"
    n "I did it! Unbelievable!"

# game/script.rpy:800
translate english misc_dialogue_bfe8df61:

    # n "誘拐の瞬間を絶対に誰もに見られてなかった。マジでうまくいった！　"
    n "Absolutely no one saw the moment I took her. It seriously worked!"

# game/script.rpy:801
translate english misc_dialogue_32ffbd57:

    # riko "ここ、どこ・・"
    riko "Where... am I...?"

# game/script.rpy:802
translate english misc_dialogue_6e21295f:

    # riko "その鎖は絶対外せないし、誰も君を助けに来ない"
    riko "Those chains will never come off, and no one is coming to save you."

# game/script.rpy:803
translate english misc_dialogue_c8547c97:

    # riko "自分がどういう状況にあるか理解できるな"
    riko "You understand the situation you're in, don't you?"

# game/script.rpy:804
translate english misc_dialogue_6cd57f8b:

    # n "「・・・」　"
    n "..."

# game/script.rpy:805
translate english misc_dialogue_16672b46:

    # riko "分かるよな"
    riko "You do understand."

# game/script.rpy:806
translate english misc_dialogue_0788b6b7:

    # n "「騒がずに大人しくしてろ、それが身のためだ」　"
    n "Stay quiet and behave. It's for your own good."

# game/script.rpy:807
translate english misc_dialogue_43d717b1:

    # riko "もし俺に逆らえば、どうなるかも分かるよな"
    riko "You do understand what will happen if you defy me, don't you?"

# game/script.rpy:808
translate english misc_dialogue_69563969:

    # riko "そうだ。こういう時は素直なのが、身のためだ"
    riko "That's right. Cooperating at a time like this is for your own good."

# game/script.rpy:809
translate english misc_dialogue_40488444_57:

    # n "　"
    n "…"

# game/script.rpy:810
translate english misc_dialogue_9030a5f7:

    # n "ん！？　"
    n "Mm!?"

# game/script.rpy:811
translate english misc_dialogue_9a85f34a:

    # n "寝てるのか　"
    n "Is she asleep?"

